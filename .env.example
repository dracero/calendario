# ==============================================================================
# CONFIGURACIÓN GENERAL DEL SISTEMA Y APIS (CLON CALENDLY)
# ==============================================================================
# Copia este archivo como .env y completa las credenciales de las APIs que desees activar.

# ------------------------------------------------------------------------------
# 1. AUTENTICACIÓN Y GOOGLE CALENDAR API (OAuth 2.0)
# ------------------------------------------------------------------------------
# Obtenidas en Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=tu_google_client_id_aqui.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret_aqui
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_SCOPES=openid email profile https://www.googleapis.com/auth/calendar.events

# ------------------------------------------------------------------------------
# 2. API DE ENVÍO DE CORREOS ELECTRÓNICOS (Workflows: Confirmación y Cancelación)
# ------------------------------------------------------------------------------
# Puedes usar la Opción A (Resend API) o la Opción B (Nodemailer SMTP / Gmail):

# Opción A: Resend API (Recomendado para Vercel / Cloud - https://resend.com)
# RESEND_API_KEY=re_123456789abcdef
# EMAIL_FROM=Reuniones <notificaciones@tudominio.com>

# Opción B: Gmail con Contraseña de Aplicación (Nodemailer service: 'gmail')
# NOTA: Google NO permite usar tu contraseña normal de Google.
# Debes tener Verificación en 2 Pasos activa y generar una contraseña en:
# https://myaccount.google.com/apppasswords
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASS=tu_contrasena_de_aplicacion
# SMTP_FROM="Reuniones" <tu_correo@gmail.com>

# Opción C: Gmail con Google OAuth2 (XOAuth2 - sin contraseñas)
# Si prefieres usar los mismos tokens de Google OAuth:
# GOOGLE_REFRESH_TOKEN=1//tu_refresh_token_aqui

# Opción D: Servidor SMTP corporativo o personalizado
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true

# ------------------------------------------------------------------------------
# 3. API DE MENSAJES DE TEXTO SMS / WHATSAPP (Workflows: Recordatorio 1h antes)
# ------------------------------------------------------------------------------
# Obtenidas en tu panel de Twilio (https://www.twilio.com/console)
TWILIO_ACCOUNT_SID=AC_tu_twilio_account_sid_aqui
TWILIO_AUTH_TOKEN=tu_twilio_auth_token_aqui
TWILIO_PHONE_NUMBER=+1234567890

# ------------------------------------------------------------------------------
# 4. CONFIGURACIÓN DEL SERVIDOR Y SESIONES
# ------------------------------------------------------------------------------
SESSION_SECRET=reuniones_super_secret_jwt_key_2026_change_in_production
APP_URL=http://localhost:3000
PORT=3000
