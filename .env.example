# ==============================================================================
# CONFIGURACIÓN DE AUTENTICACIÓN GOOGLE (CLON CALENDLY) - EJEMPLO
# ==============================================================================
# Copia este archivo como .env y completa tus credenciales de Google Cloud Console.

# ID de Cliente OAuth de Google Cloud
GOOGLE_CLIENT_ID=tu_google_client_id_aqui.apps.googleusercontent.com

# Secreto de Cliente OAuth de Google Cloud
GOOGLE_CLIENT_SECRET=tu_google_client_secret_aqui

# URI a la que Google redirige tras autorizar la cuenta
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Permisos solicitados a Google
GOOGLE_SCOPES="openid email profile https://www.googleapis.com/auth/calendar.events"

# Clave secreta para firmar sesiones locales
SESSION_SECRET=reuniones_super_secret_jwt_key_2026_change_in_production

# URL base de la aplicación
APP_URL=http://localhost:3000

# Puerto del servidor web
PORT=3000
